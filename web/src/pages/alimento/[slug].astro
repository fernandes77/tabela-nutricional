---
import Layout from '../../layouts/Layout.astro';
import NutritionalTable from '../../components/NutritionalTable.astro';
import { fetchFoods } from '../../lib/api';
import type { Food } from '../../types/food';

export async function getStaticPaths() {
  const foods = await fetchFoods('both');
  
  return foods.map((food) => ({
    params: { slug: food.slug },
    props: { food },
  }));
}

interface Props {
  food: Food;
}

const { food } = Astro.props;
---

<Layout title={`${food.nome} - Tabela Nutricional`} description={`Informações nutricionais de ${food.nome}. Calorias, proteínas, carboidratos, vitaminas e minerais.`}>
  <main class="main">
    <nav class="breadcrumb">
      <a href="/" class="back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        Voltar
      </a>
    </nav>

    <header class="header">
      <div class="food-badge">
        <span class={`source-tag ${food.source}`}>{food.source.toUpperCase()}</span>
        {food.grupo && <span class="group-tag">{food.grupo}</span>}
      </div>
      <h1 class="food-title">{food.nome}</h1>
      {food.nomeCientifico && (
        <p class="scientific-name">{food.nomeCientifico}</p>
      )}
    </header>

    <section class="content">
      <NutritionalTable food={food} />
    </section>

    <footer class="footer">
      <p>
        Dados da tabela <a href={food.source === 'taco' ? 'https://www.nepa.unicamp.br/taco/' : 'https://www.tbca.net.br/'} target="_blank" rel="noopener">
          {food.source === 'taco' ? 'TACO (UNICAMP)' : 'TBCA (USP)'}
        </a>
      </p>
    </footer>
  </main>
</Layout>

<style>
  .main {
    min-height: 100vh;
    max-width: 900px;
    margin: 0 auto;
    padding: 24px;
    display: flex;
    flex-direction: column;
  }

  .breadcrumb {
    margin-bottom: 20px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: 0.875rem;
    transition: all 0.15s ease;
  }

  .back-link:hover {
    background: var(--color-bg-hover);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .back-link svg {
    width: 16px;
    height: 16px;
  }

  .header {
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border);
  }

  .food-badge {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }

  .source-tag {
    padding: 3px 8px;
    border-radius: 3px;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .source-tag.taco {
    background: rgba(37, 99, 235, 0.1);
    color: var(--color-accent);
    border: 1px solid rgba(37, 99, 235, 0.2);
  }

  .source-tag.tbca {
    background: rgba(22, 163, 74, 0.1);
    color: var(--color-success);
    border: 1px solid rgba(22, 163, 74, 0.2);
  }

  .group-tag {
    padding: 3px 8px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  .food-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.3;
    margin-bottom: 6px;
    letter-spacing: -0.01em;
  }

  .scientific-name {
    font-style: italic;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: 4px;
  }

  .food-code {
    font-size: 0.8125rem;
    color: var(--color-text-dimmed);
  }

  .content {
    flex: 1;
  }

  .footer {
    text-align: left;
    padding: 24px 0 16px;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    border-top: 1px solid var(--color-border);
    margin-top: 32px;
  }

  .footer a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer a:hover {
    color: var(--color-accent-hover);
  }

  .disclaimer {
    margin-top: 6px;
    color: var(--color-text-dimmed);
  }

  @media (max-width: 640px) {
    .main {
      padding: 16px;
    }

    .header {
      margin-bottom: 20px;
    }

    .food-title {
      font-size: 1.5rem;
    }
  }
</style>

