---
---

<div id="food-list" class="food-list">
  <div id="results-info" class="results-info"></div>
  <ul id="results-container" class="results-container"></ul>
  <div id="empty-state" class="empty-state">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
    <p>Digite para pesquisar alimentos</p>
  </div>
  <div id="no-results" class="no-results" style="display: none;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <p>Nenhum alimento encontrado</p>
  </div>
</div>

<style>
  .food-list {
    width: 100%;
    max-width: 800px;
    margin: 20px auto 0;
  }

  .results-info {
    padding: 0 2px;
    margin-bottom: 8px;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .results-container {
    list-style: none;
    padding: 0;
    margin: 0;
    max-height: 60vh;
    overflow-y: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
  }

  .results-container::-webkit-scrollbar {
    width: 6px;
  }

  .results-container::-webkit-scrollbar-track {
    background: var(--color-bg-elevated);
  }

  .results-container::-webkit-scrollbar-thumb {
    background: var(--color-border-dark);
    border-radius: 3px;
  }

  .empty-state,
  .no-results {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 40px 24px;
    color: var(--color-text-dimmed);
    text-align: center;
  }

  .empty-state svg,
  .no-results svg {
    width: 40px;
    height: 40px;
    opacity: 0.4;
  }

  .empty-state p,
  .no-results p {
    font-size: 0.9375rem;
    margin: 0;
    color: var(--color-text-muted);
  }
</style>

<style is:global>
  .food-item {
    animation: slideUp 0.15s ease-out both;
  }

  .food-item a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: var(--color-bg-card);
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.1s ease;
    text-decoration: none;
    color: inherit;
  }

  .food-item:last-child a {
    border-bottom: none;
  }

  .food-item a:hover {
    background: var(--color-bg-hover);
  }

  .food-item a:hover .food-name {
    color: var(--color-accent);
  }

  .food-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--color-primary);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .food-icon svg {
    width: 18px;
    height: 18px;
    color: white;
  }

  .food-info {
    flex: 1;
    min-width: 0;
  }

  .food-name {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.1s ease;
  }

  .food-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .food-group {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .food-source {
    padding: 1px 6px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    flex-shrink: 0;
  }

  .food-source.taco {
    color: var(--color-accent);
    border-color: rgba(37, 99, 235, 0.2);
  }

  .food-source.tbca {
    color: var(--color-success);
    border-color: rgba(22, 163, 74, 0.2);
  }

  .food-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-dimmed);
    flex-shrink: 0;
  }

  .food-arrow svg {
    width: 16px;
    height: 16px;
  }

  .highlight {
    background: rgba(37, 99, 235, 0.15);
    color: var(--color-accent);
    border-radius: 2px;
    padding: 0 2px;
  }
</style>

